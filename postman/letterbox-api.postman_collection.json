    {
      "name": "Films CRUD",
      "item": [
        {
          "name": "Index - tampil semua film",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('respons berupa larik JSON', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
