{
  "info": {
    "_postman_id": "b7f3c1a2-4d5e-4f60-9a71-letterbox2026",
    "name": "Letterbox API - UTS KEPL 24/535316/SV/24196",
    "description": "Koleksi Postman untuk REST API Letterbox (Laravel + Sanctum).\n\nBase URL: {{baseUrl}} = http://localhost:8000/api\nAkun demo: test@example.com / password\n\nJalankan request secara berurutan: Login menyimpan token ke variabel koleksi, lalu request lain memakai Bearer {{token}}. Logout diletakkan paling akhir karena menghapus token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (publik, simpan token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('respons berisi token Bearer', () => {",
                  "  pm.expect(data).to.have.property('token');",
                  "  pm.expect(data.token_type).to.eql('Bearer');",
                  "});",
                  "if (data.token) pm.collectionVariables.set('token', data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/login", "host": ["{{baseUrl}}"], "path": ["login"] }
          }
        },
        {
          "name": "Login password salah (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password-salah\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/login", "host": ["{{baseUrl}}"], "path": ["login"] }
          }
        },
        {
          "name": "Me (butuh token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('email pengguna sesuai', () => pm.expect(pm.response.json().email).to.eql('test@example.com'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "url": { "raw": "{{baseUrl}}/me", "host": ["{{baseUrl}}"], "path": ["me"] }
          }
        },
        {
          "name": "Register (butuh token, 201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Anggota Baru\",\n  \"email\": \"anggota{{$timestamp}}@example.com\",\n  \"password\": \"rahasia123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/register", "host": ["{{baseUrl}}"], "path": ["register"] }
          }
        },
        {
          "name": "Logout (hapus token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', '');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "url": { "raw": "{{baseUrl}}/logout", "host": ["{{baseUrl}}"], "path": ["logout"] }
          }
        }
      ]
    },
    {
      "name": "Films CRUD",
      "item": [
        {
          "name": "Index - tampil semua film",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('respons berupa larik JSON', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "url": { "raw": "{{baseUrl}}/films", "host": ["{{baseUrl}}"], "path": ["films"] }
          }
        },
        {
          "name": "Store - tambah film (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201 Created', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.test('film tersimpan dengan id', () => pm.expect(data).to.have.property('id'));",
                  "pm.collectionVariables.set('filmId', data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Perfect Days\",\n  \"director\": \"Wim Wenders\",\n  \"year\": 2023,\n  \"status\": \"ingin_ditonton\",\n  \"rating\": null,\n  \"review\": \"Pelan dan tenang.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/films", "host": ["{{baseUrl}}"], "path": ["films"] }
          }
        },
        {
          "name": "Show - tampil satu film",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('id sesuai variabel filmId', () => pm.expect(String(pm.response.json().id)).to.eql(String(pm.collectionVariables.get('filmId'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "url": {
              "raw": "{{baseUrl}}/films/{{filmId}}",
              "host": ["{{baseUrl}}"],
              "path": ["films", "{{filmId}}"]
            }
          }
        },
        {
          "name": "Update - ubah film (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('judul berubah', () => pm.expect(pm.response.json().title).to.eql('Perfect Days (edit)'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Perfect Days (edit)\",\n  \"director\": \"Wim Wenders\",\n  \"year\": 2023,\n  \"status\": \"sudah_ditonton\",\n  \"rating\": 5,\n  \"review\": \"Sudah selesai ditonton.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/films/{{filmId}}",
              "host": ["{{baseUrl}}"],
              "path": ["films", "{{filmId}}"]
            }
          }
        },
        {
          "name": "Destroy - hapus film (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('filmId', '');"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "url": {
              "raw": "{{baseUrl}}/films/{{filmId}}",
              "host": ["{{baseUrl}}"],
              "path": ["films", "{{filmId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Kasus Negatif",
      "item": [
        {
          "name": "Index tanpa token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('pesan Unauthenticated', () => pm.expect(pm.response.json().message).to.eql('Unauthenticated.'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "url": { "raw": "{{baseUrl}}/films", "host": ["{{baseUrl}}"], "path": ["films"] }
          }
        },
        {
          "name": "Store validasi gagal (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 422 Unprocessable Content', () => pm.response.to.have.status(422));",
                  "pm.test('ada errors.title', () => pm.expect(pm.response.json().errors).to.have.property('title'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"\",\n  \"director\": \"\",\n  \"year\": 1800,\n  \"status\": \"tidak-valid\",\n  \"rating\": 9\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/films", "host": ["{{baseUrl}}"], "path": ["films"] }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000/api" },
    { "key": "token", "value": "" },
    { "key": "filmId", "value": "" }
  ]
}
