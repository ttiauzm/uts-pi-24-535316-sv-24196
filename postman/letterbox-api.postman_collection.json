                  "pm.test('status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('judul berubah', () => pm.expect(pm.response.json().title).to.eql('Perfect Days (edit)'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
