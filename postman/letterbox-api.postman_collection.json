            "url": {
              "raw": "{{baseUrl}}/films",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "films"
              ]
            }
          }
        },
        {
          "name": "Store - tambah film (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('film tersimpan dengan id', () => pm.expect(body).to.have.property('id'));",
                  "pm.collectionVariables.set('filmId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Perfect Days\",\n  \"director\": \"Wim Wenders\",\n  \"year\": 2023,\n  \"status\": \"ingin_ditonton\",\n  \"rating\": null,\n  \"review\": \"Pelan dan tenang.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/films",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "films"
              ]
            }
          }
        },
        {
          "name": "Show - tampil satu film",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('id sesuai variabel filmId', () => pm.expect(String(pm.response.json().id)).to.eql(String(pm.collectionVariables.get('filmId'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/films/{{filmId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "films",
                "{{filmId}}"
              ]
            }
          }
        },
        {
          "name": "Update - ubah film (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
