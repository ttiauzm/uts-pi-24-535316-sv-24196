# Alamat API yang dipanggil browser.
# Default "/api" memakai origin yang sama; Nginx (Docker) meneruskannya ke
# service "backend" di jaringan Compose, sedangkan Vite dev server memakai proxy.
VITE_API_URL=/api

# Hanya dipakai `npm run dev` (bukan build): target proxy Vite ke Laravel lokal.
VITE_DEV_API_TARGET=http://127.0.0.1:8000
